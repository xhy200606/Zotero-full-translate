# Zotero-full-translate Cloud — single-container configuration
ZFT_API_KEY=change-me-with-openssl-rand-hex-32
ZFT_CONFIG_SECRET=change-me-with-a-different-openssl-rand-hex-32

# One public port serves BOTH the Material 3 frontend and REST/SSE API.
ZFT_PORT=3005
# Same-origin frontend normally needs no CORS. Keep these only for alternate clients/dev UI.
ZFT_CORS_ORIGINS=http://localhost:3002,http://localhost:3005,http://localhost:8089

# Persistent paths inside the one Docker volume.
DATABASE_URL=sqlite:////data/zft.db
ZFT_STORAGE_DIR=/data/files
ZFT_WORK_DIR=/data/work

# BabelDOC runtime defaults
ZFT_MAX_ACTIVE_JOBS=1
BABELDOC_QPS=1
BABELDOC_POOL_MAX_WORKERS=1
BABELDOC_MULTI_POOL_MAX_WORKERS=12
BABELDOC_AGGREGATE_QPS_CAP=100
BABELDOC_REPORT_INTERVAL=0.5
BABELDOC_MAX_PAGES_PER_PART=50
BABELDOC_SKIP_SCANNED_DETECTION=false
BABELDOC_AUTO_OCR_WORKAROUND=true

# Default provider bootstrap
ZFT_TRANSLATOR_PROVIDER=openai_compatible
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

BAIDU_APP_ID=
BAIDU_SECRET_KEY=
BAIDU_ENDPOINT=https://fanyi-api.baidu.com/api/trans/vip/translate
# Web UI can switch Baidu to API Key/Bearer mode after first startup.

# Optional provider bootstrap credentials (can also be configured in the Web UI)
# Tencent: SecretId/SecretKey bootstrap the TMT compatibility mode; TokenHub is optional.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_TOKENHUB_API_KEY=
# Volcengine Machine Translation API key
VOLC_API_KEY=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
