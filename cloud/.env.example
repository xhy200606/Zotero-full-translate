ZFT_CONFIG_SECRET=change-me-with-openssl-rand-hex-32

ZFT_API_KEY=

ZFT_BIND=0.0.0.0
ZFT_PORT=3005
ZFT_ADMIN_BIND=127.0.0.1
ZFT_ADMIN_PORT=3006

ZFT_BOOTSTRAP_ADMIN_USERNAME=admin
ZFT_BOOTSTRAP_ADMIN_PASSWORD=
ZFT_TOKEN_TTL_DAYS=180
ZFT_LOGIN_MAX_ATTEMPTS=10
ZFT_LOGIN_WINDOW_SECONDS=300
ZFT_REGISTRATION_MAX_ATTEMPTS=5
ZFT_REGISTRATION_WINDOW_SECONDS=3600

ZFT_PUBLIC_HARDENING=true
ZFT_ALLOWED_HOSTS=*
ZFT_EXPOSE_API_DOCS=false
ZFT_MAX_UPLOAD_MB=200
ZFT_ALLOW_PRIVATE_PROVIDER_ENDPOINTS=false
ZFT_ALLOW_INSECURE_PROVIDER_HTTP=false

ZFT_TIMEZONE=Asia/Shanghai

ZFT_CORS_ORIGINS=http://localhost:3005,http://localhost:3006,http://localhost:8089

DATABASE_URL=sqlite:////data/zft.db
ZFT_STORAGE_DIR=/data/files
ZFT_WORK_DIR=/data/work

ZFT_MAX_ACTIVE_JOBS=1
BABELDOC_QPS=1
BABELDOC_POOL_MAX_WORKERS=1
BABELDOC_MULTI_POOL_MAX_WORKERS=12
BABELDOC_AGGREGATE_QPS_CAP=100
BABELDOC_REPORT_INTERVAL=0.5
BABELDOC_MAX_PAGES_PER_PART=50
BABELDOC_SKIP_SCANNED_DETECTION=false
BABELDOC_AUTO_OCR_WORKAROUND=true
